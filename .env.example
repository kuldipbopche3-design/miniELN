# ─── Supabase ────────────────────────────────────────────────────────────────
# Copy this file to .env.local for local development and fill in real values.
# For Netlify, set these in Site Settings → Environment variables (not here).
#
# SAFE TO COMMIT — contains no real secrets.

# Your Supabase project URL.
# Found in: Supabase Dashboard → Project Settings → API → Project URL
# Used by: browser client, server client, middleware
# Must have NEXT_PUBLIC_ prefix so Next.js exposes it to the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co

# Your Supabase anon/public key (safe to expose to the browser).
# Found in: Supabase Dashboard → Project Settings → API → Project API keys → anon public
# Used by: browser client, server client, middleware
# Must have NEXT_PUBLIC_ prefix so Next.js exposes it to the browser bundle.
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# ─── DANGER: Never expose this key publicly ───────────────────────────────
# Your Supabase service role key (bypasses RLS — server-only).
# Found in: Supabase Dashboard → Project Settings → API → Project API keys → service_role
# Used by: admin/server-only scripts only (NOT referenced in the Next.js app code).
# Set in Netlify as a sensitive env var. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
